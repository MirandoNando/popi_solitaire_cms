rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /emoticons/{fileName} {
      // Read: any Popi Solitaire Firebase app session (silent anonymous OR registered).
      // Player email/password login is NOT required for downloads.
      // Unity strips download tokens and sends Authorization: Firebase <idToken>.
      allow read: if request.auth != null;

      // Write/delete: authenticated CMS / admin sessions only (not for gameplay clients).
      allow create, update: if request.auth != null
                            && request.resource.size < 5 * 1024 * 1024
                            && (
                              request.resource.contentType.matches('image/.*')
                              || fileName.matches('.*\\.(png|jpg|jpeg|webp|PNG|JPG|JPEG|WEBP)$')
                            );

      allow delete: if request.auth != null;
    }

    match /quotes/{fileName} {
      // Public read so CMS + Unity can show quote icons from iconUrl.
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.resource.size < 5 * 1024 * 1024
                            && (
                              request.resource.contentType.matches('image/.*')
                              || fileName.matches('.*\\.(png|jpg|jpeg|webp|PNG|JPG|JPEG|WEBP)$')
                            );
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
