rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /emoticons/{fileName} {
      // Unity needs public download URLs
      allow read: if true;
      // Only logged-in CMS admin can upload/delete
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
