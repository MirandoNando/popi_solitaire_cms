rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /emoticon_cms/{docId} {
      // Unity / client game: read only
      allow read: if true;
      // CMS admin: write only when logged in
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
