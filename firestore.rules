rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CMS config — readable with app Firebase session (anonymous OK). No player login required.
    match /emoticon_cms/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Home quote panel config (CMS Quotes tab).
    match /quotes_cms/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Player profiles (AuthManager Register / Profile).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
