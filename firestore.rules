rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CMS config — readable with app Firebase session (anonymous OK). No player login required.
    match /emoticon_cms/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Home quote panel config (CMS Quotes tab).
    // Public read: Unity / CMS preview. Write tetap butuh login admin.
    match /quotes_cms/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Home event / quest config (CMS Events tab).
    // Public read: Unity float quest. Write: CMS admin login.
    match /events_cms/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Progress agregat 1 dokumen / user (Unity flush ~10s).
    // CMS admin (non-anonymous) boleh baca + update/hapus peserta.
    match /event_progress_users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId
        || request.auth.token.firebase.sign_in_provider != 'anonymous'
      );
      allow delete: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Legacy per-event progress (baca/hapus CMS; game baru tidak menulis).
    match /event_progress/{eventId}/users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Quest completions — user create sekali; CMS admin baca/hapus.
    match /event_completions/{eventId}/users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !exists(/databases/$(database)/documents/event_completions/$(eventId)/users/$(userId));
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt']);
      allow delete: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Player profiles (AuthManager Register / Profile).
    // CMS boleh update field joinedEvents saja (hapus peserta).
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || request.auth.token.firebase.sign_in_provider != 'anonymous'
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId
        || (
          request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedEvents'])
        )
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
